# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/safollo_crm

# JWT
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMS - SSL Wireless Bangladesh
SMS_API_KEY=your_sslwireless_api_key
SMS_SID=your_sid
SMS_SENDER_ID=SAFOLLO

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# OTP expiry (minutes)
OTP_EXPIRES_MINUTES=5
